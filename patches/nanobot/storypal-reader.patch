+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+describe("StoryPal 网页用户标识", () => {
+  beforeEach(() => {
+    vi.resetModules();
+    localStorage.clear();
+  });
+
+  it("刷新模块后保留相同 ID，且不改动已有的 ID", async () => {
+    const first = await import("@/lib/storypal-client-id");
+    const url = first.withStoryPalClientId("ws://127.0.0.1:8765/?token=abc");
+    const id = new URL(url).searchParams.get("client_id");
+    expect(id).toMatch(/^storypal-web-/);
+
+    vi.resetModules();
+    const second = await import("@/lib/storypal-client-id");
+    expect(new URL(second.withStoryPalClientId("ws://127.0.0.1:8765/?token=xyz")).searchParams.get("client_id")).toBe(id);
+    expect(second.withStoryPalClientId("ws://127.0.0.1:8765/?client_id=external")).toBe("ws://127.0.0.1:8765/?client_id=external");
+  });
+});
