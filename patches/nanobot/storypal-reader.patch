+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { StoryReaderPane } from "@/components/StoryReaderPane";
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+  localStorage.clear();
+});
+
+describe("桌面阅读器", () => {
+  it("只在点击章末按钮后报告已读，滚动不会推进", async () => {
+    const fetchMock = vi.fn().mockResolvedValue({
+      ok: true,
+      json: async () => ({
+        work_id: "wandering_earth",
+        title: "流浪地球",
+        source_version: "v1",
+        locations: [{ location_id: "chapter-01", label: "第一章", start_order: 1, end_order: 1 }],
+        units: [{ unit_id: "we-0001", order: 1, chapter_name: "第一章", start_line: 5, end_line: 7, text: "开篇原文" }],
+      }),
+    });
+    vi.stubGlobal("fetch", fetchMock);
+    Element.prototype.scrollIntoView = vi.fn();
+    const onReportChapter = vi.fn().mockResolvedValue(undefined);
+
+    const { container } = render(
+      <StoryReaderPane
+        getToken={() => "test-token"}
+        onClose={vi.fn()}
+        onAsk={vi.fn()}
+        onReportChapter={onReportChapter}
+        chatBusy={false}
+      />,
+    );
+
+    await screen.findByText("开篇原文");
+    expect(fetchMock).toHaveBeenCalledWith("/api/webui/storypal-reader", expect.objectContaining({
+      headers: { Authorization: "Bearer test-token" },
+    }));
+    fireEvent.scroll(container.querySelector("[data-order='1']")!.parentElement!);
+    expect(onReportChapter).not.toHaveBeenCalled();
+    fireEvent.click(screen.getByRole("button", { name: "我已读完本章" }));
+    await waitFor(() => expect(onReportChapter).toHaveBeenCalledWith(expect.objectContaining({ location_id: "chapter-01" })));
+  });
+});
