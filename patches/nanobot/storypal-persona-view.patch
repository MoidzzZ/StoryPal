+_PERSONA_DOCUMENTS = (
+    ("soul", "SOUL.md", "身份与语气", "StoryPal 的稳定身份、关系定位与表达风格。"),
+    ("agents", "AGENTS.md", "对话规则", "产品契约、工具策略、记忆边界与防剧透规则。"),
+    ("user", "USER.md", "用户信息", "只保存经过用户确认的信息，不自动推断人格。"),
+)
+_PERSONA_DOCUMENT_MAX_CHARS = 128_000
+
+
+def _persona_documents(config: Config) -> list[dict[str, Any]]:
+    """Return the three allowlisted StoryPal persona files for read-only display."""
+    workspace = Path(str(config.agents.defaults.workspace)).expanduser().resolve(strict=False)
+    documents: list[dict[str, Any]] = []
+    for document_id, filename, title, description in _PERSONA_DOCUMENTS:
+        candidate = (workspace / filename).resolve(strict=False)
+        content = ""
+        error: str | None = None
+        truncated = False
+        if candidate.parent != workspace:
+            error = "文件路径超出 StoryPal 工作区。"
+        elif not candidate.is_file():
+            error = "文件尚未创建。"
+        else:
+            try:
+                content = candidate.read_text(encoding="utf-8")
+            except (OSError, UnicodeError):
+                error = "文件暂时无法读取。"
+            if len(content) > _PERSONA_DOCUMENT_MAX_CHARS:
+                content = content[:_PERSONA_DOCUMENT_MAX_CHARS]
+                truncated = True
+        documents.append(
+            {
+                "id": document_id,
+                "filename": filename,
+                "title": title,
+                "description": description,
+                "content": content,
+                "available": error is None,
+                "truncated": truncated,
+                "error": error,
+            }
+        )
+    return documents
+
+
 _RUNTIME_CAPABILITIES = {
     "can_restart_engine": False,
     "can_pick_folder": False,
