diff --git a/webui/src/components/settings/persona/PersonaSettings.tsx b/webui/src/components/settings/persona/PersonaSettings.tsx
new file mode 100644
--- /dev/null
+++ b/webui/src/components/settings/persona/PersonaSettings.tsx
@@ -0,0 +1,150 @@
+import { Bot, ScrollText, UserRound, type LucideIcon } from "lucide-react";
+import { useMemo, useState } from "react";
+
+import { MarkdownText } from "@/components/MarkdownText";
+import type { SettingsPayload } from "@/lib/types";
+import { cn } from "@/lib/utils";
+
+type PersonaDocument = NonNullable<SettingsPayload["persona_documents"]>[number];
+type PersonaDocumentId = PersonaDocument["id"];
+
+const DOCUMENT_META: Array<{
+  id: PersonaDocumentId;
+  filename: PersonaDocument["filename"];
+  title: string;
+  description: string;
+  icon: LucideIcon;
+}> = [
+  {
+    id: "soul",
+    filename: "SOUL.md",
+    title: "身份与语气",
+    description: "StoryPal 是谁，以及它应该怎样与你交谈。",
+    icon: Bot,
+  },
+  {
+    id: "agents",
+    filename: "AGENTS.md",
+    title: "对话规则",
+    description: "工具、记忆、剧情证据和防剧透边界。",
+    icon: ScrollText,
+  },
+  {
+    id: "user",
+    filename: "USER.md",
+    title: "用户信息",
+    description: "只展示经过确认的信息，不自动推断人格。",
+    icon: UserRound,
+  },
+];
+
+export function PersonaSettings({
+  documents = [],
+}: {
+  documents?: SettingsPayload["persona_documents"];
+}) {
+  const [activeId, setActiveId] = useState<PersonaDocumentId>("soul");
+  const documentsById = useMemo(
+    () => new Map(documents.map((document) => [document.id, document])),
+    [documents],
+  );
+  const activeMeta = DOCUMENT_META.find((item) => item.id === activeId) ?? DOCUMENT_META[0];
+  const activeDocument = documentsById.get(activeId);
+
+  return (
+    <div className="space-y-6">
+      <header className="space-y-2">
+        <p className="text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">
+          StoryPal
+        </p>
+        <h1 className="text-[26px] font-normal tracking-tight text-foreground">人格与规则</h1>
+        <p className="max-w-2xl text-[13px] leading-6 text-muted-foreground">
+          这里展示每轮对话都会重新装配的三个稳定 Markdown 文件。页面只读；受约束的 Dream 可更新身份与用户认识，故事记忆保持不可写。
+        </p>
+      </header>
+
+      <div
+        role="tablist"
+        aria-label="人格文档"
+        className="grid gap-2 sm:grid-cols-3"
+      >
+        {DOCUMENT_META.map((item) => {
+          const Icon = item.icon;
+          const active = item.id === activeId;
+          const document = documentsById.get(item.id);
+          return (
+            <button
+              key={item.id}
+              type="button"
+              role="tab"
+              aria-selected={active}
+              aria-controls="storypal-persona-document"
+              onClick={() => setActiveId(item.id)}
+              className={cn(
+                "rounded-panel border px-4 py-4 text-left transition-colors",
+                active
+                  ? "border-foreground/15 bg-settings-surface text-foreground shadow-sm"
+                  : "border-transparent bg-settings-surface/60 text-muted-foreground hover:bg-settings-surface",
+              )}
+            >
+              <span className="flex items-center justify-between gap-3">
+                <span className="flex items-center gap-2 text-[13px] font-semibold">
+                  <Icon className="h-4 w-4" aria-hidden />
+                  {item.title}
+                </span>
+                <span
+                  className={cn(
+                    "h-2 w-2 rounded-full",
+                    document?.available ? "bg-emerald-500" : "bg-amber-500",
+                  )}
+                  aria-label={document?.available ? "可读取" : "不可读取"}
+                />
+              </span>
+              <span className="mt-2 block font-mono text-[11px] text-muted-foreground/75">
+                {item.filename}
+              </span>
+              <span className="mt-2 block text-[12px] leading-5">{item.description}</span>
+            </button>
+          );
+        })}
+      </div>
+
+      <section
+        id="storypal-persona-document"
+        role="tabpanel"
+        className="overflow-hidden rounded-panel bg-settings-surface"
+      >
+        <div className="flex flex-wrap items-center justify-between gap-3 border-b border-border/55 px-5 py-4">
+          <div>
+            <h2 className="text-[15px] font-semibold text-foreground">{activeMeta.title}</h2>
+            <p className="mt-1 font-mono text-[11px] text-muted-foreground">
+              {activeMeta.filename}
+            </p>
+          </div>
+          <span className="rounded-full bg-muted px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
+            只读
+          </span>
+        </div>
+        <div className="min-h-[360px] px-5 py-5 sm:px-7 sm:py-6">
+          {!activeDocument?.available ? (
+            <div className="rounded-control border border-amber-500/20 bg-amber-500/5 px-4 py-3 text-[13px] text-amber-700 dark:text-amber-300">
+              {activeDocument?.error ?? "该文档暂时不可读取。"}
+            </div>
+          ) : activeDocument.content.trim() ? (
+            <MarkdownText className="max-w-none text-[14px] leading-7">
+              {activeDocument.content}
+            </MarkdownText>
+          ) : (
+            <p className="text-[13px] text-muted-foreground">该文档当前为空。</p>
+          )}
+          {activeDocument?.truncated ? (
+            <p className="mt-5 text-[11px] text-amber-700 dark:text-amber-300">
+              文档过长，页面仅展示前 128,000 个字符。
+            </p>
+          ) : null}
+        </div>
+      </section>
+    </div>
+  );
+}
+

diff --git a/webui/src/tests/settings-persona.test.tsx b/webui/src/tests/settings-persona.test.tsx
new file mode 100644
--- /dev/null
+++ b/webui/src/tests/settings-persona.test.tsx
@@ -0,0 +1,55 @@
+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { describe, expect, it } from "vitest";
+
+import { PersonaSettings } from "@/components/settings/persona/PersonaSettings";
+import type { SettingsPayload } from "@/lib/types";
+
+const documents: NonNullable<SettingsPayload["persona_documents"]> = [
+  {
+    id: "soul",
+    filename: "SOUL.md",
+    title: "身份与语气",
+    description: "Identity",
+    content: "# StoryPal Soul\n\nWarm and direct.",
+    available: true,
+    truncated: false,
+    error: null,
+  },
+  {
+    id: "agents",
+    filename: "AGENTS.md",
+    title: "对话规则",
+    description: "Rules",
+    content: "# StoryPal Rules\n\nNever spoil future chapters.",
+    available: true,
+    truncated: false,
+    error: null,
+  },
+  {
+    id: "user",
+    filename: "USER.md",
+    title: "用户信息",
+    description: "Confirmed user information",
+    content: "",
+    available: true,
+    truncated: false,
+    error: null,
+  },
+];
+
+describe("PersonaSettings", () => {
+  it("shows all three persona documents and switches the rendered markdown", async () => {
+    const user = userEvent.setup();
+    render(<PersonaSettings documents={documents} />);
+
+    expect(screen.getByRole("tabpanel")).toHaveTextContent("StoryPal Soul");
+    expect(screen.getAllByRole("tab")).toHaveLength(3);
+
+    await user.click(screen.getByRole("tab", { name: /对话规则/ }));
+
+    expect(screen.getByRole("tabpanel")).toHaveTextContent("StoryPal Rules");
+    expect(screen.getByRole("tabpanel")).toHaveTextContent("Never spoil future chapters.");
+  });
+});
+
