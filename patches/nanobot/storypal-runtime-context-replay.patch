+def runtime_context_replay_records(marker, sources, blocks):
+    """Preserve per-block replay policy across message merges, including legacy suffixes."""
+    records = marker.get("replay_records") if isinstance(marker, Mapping) else None
+    if isinstance(records, list) and len(records) == len(blocks) and all(
+        isinstance(record, dict) and record.get("block") == block and type(record.get("replay")) is bool
+        and isinstance(record.get("sources"), list) and all(isinstance(s, str) for s in record["sources"])
+        for record, block in zip(records, blocks)
+    ):
+        return deepcopy(records)
+    return [{"block": deepcopy(block), "sources": [sources[i]] if len(sources) == len(blocks) else list(sources),
+             "replay": True} for i, block in enumerate(blocks)]
+
+
+def replay_history_message(message: Mapping[str, Any]) -> dict[str, Any]:
+    """Omit only opted-out runtime blocks; never alter the durable transcript."""
+    cleaned = deepcopy(dict(message))
+    marker = cleaned.get(RUNTIME_CONTEXT_HISTORY_META)
+    if not isinstance(marker, Mapping) or "replay_records" not in marker:
+        return cleaned
+    detached = detach_runtime_context(cleaned.get("content"), marker)
+    if detached is None:
+        return cleaned
+    visible, sources, blocks = detached
+    records = runtime_context_replay_records(marker, sources, blocks)
+    kept = [record for record in records if record["replay"]]
+    cleaned.pop(RUNTIME_CONTEXT_HISTORY_META, None)
+    if kept:
+        content, new_marker = reattach_runtime_context(visible,
+            [source for record in kept for source in record["sources"]],
+            [record["block"] for record in kept])
+        cleaned["content"] = content
+        cleaned[RUNTIME_CONTEXT_HISTORY_META] = new_marker
+    else:
+        cleaned["content"] = visible
+    return cleaned
+
+
+def runtime_context_requires_fresh_replay(messages: Iterable[Mapping[str, Any]]) -> bool:
+    """Opaque provider state cannot remove opted-out historical input blocks."""
+    for message in messages:
+        marker = message.get(RUNTIME_CONTEXT_HISTORY_META)
+        if isinstance(marker, Mapping) and "replay_records" in marker:
+            if replay_history_message(message).get("content") != message.get("content"):
+                return True
+    return False
 
 
