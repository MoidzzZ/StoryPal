+    @pytest.mark.asyncio
+    async def test_dream_editable_files_can_exclude_general_memory(self, tmp_path):
+        store = MemoryStore(
+            tmp_path,
+            dream_editable_files=["SOUL.md", "USER.md"],
+        )
+        store.write_memory("# Story memory\n\nDo not change this.")
+        tools = store.build_dream_tools()
+
+        blocked = await tools.execute(
+            "write_file",
+            {
+                "path": "memory/MEMORY.md",
+                "content": "overwritten",
+            },
+        )
+        allowed = await tools.execute(
+            "write_file",
+            {
+                "path": "USER.md",
+                "content": "# User\n\n- Prefers reflective discussion.\n",
+            },
+        )
+
+        assert "outside allowed directory" in blocked
+        assert store.read_memory() == "# Story memory\n\nDo not change this."
+        assert "Successfully wrote" in allowed
+        assert "reflective discussion" in store.read_user()
+        assert store._dream_content_paths == ("SOUL.md", "USER.md")
+
